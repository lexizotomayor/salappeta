<section id="stay" class="section bg-deep auto" style="--min:340px;--gap:var(--s6)" aria-labelledby="stay-h">
  <div>
    <h2 id="stay-h" class="h-section h-section--sm mb-4">stay informed</h2>
    <p class="body mb-5" style="max-width:24em">One email when something changes — a new law, a court order, a delayed payment. Nothing else.</p>
    <form class="stay-form" name="newsletter" method="POST" data-netlify="true" netlify-honeypot="bot-field" action="/thanks/" data-ajax-form data-success="Thank you — check your inbox to confirm.">
      <input type="hidden" name="form-name" value="newsletter">
      <p hidden><label>Leave empty <input type="text" name="bot-field" tabindex="-1" autocomplete="off"></label></p>
      <label class="field-label" for="em">Email address</label>
      <input class="field-line" id="em" name="email" type="email" required autocomplete="email" placeholder="name@example.com">
      <button class="btn btn--sm stay-submit" type="submit">Send me updates</button>
    </form>
  </div>
  <div class="feedback">
    <h3 class="h-sub mb-3" style="margin-bottom:var(--s2)">Tell us something</h3>
    <p class="body-sm mb-4" style="max-width:28em">A question, a correction, or your own story. We read everything.</p>
    <form name="feedback" method="POST" data-netlify="true" netlify-honeypot="bot-field" action="/thanks/" data-ajax-form data-success="Received. Thank you.">
      <input type="hidden" name="form-name" value="feedback">
      <p hidden><label>Leave empty <input type="text" name="bot-field" tabindex="-1" autocomplete="off"></label></p>
      <fieldset>
        <legend class="visually-hidden">What is it about?</legend>
        <div class="chips">
          <label class="chip-radio"><input type="radio" name="type" value="question" checked><span>A question</span></label>
          <label class="chip-radio"><input type="radio" name="type" value="correction"><span>A correction</span></label>
          <label class="chip-radio"><input type="radio" name="type" value="story"><span>My story</span></label>
        </div>
      </fieldset>
      <label class="visually-hidden" for="msg">Message</label>
      <textarea class="field-box" id="msg" name="message" rows="5" required placeholder="Write here…"></textarea>
      <label class="body-sm" for="fe" style="font-weight:600">Email (optional, if you’d like a reply)</label>
      <input class="field-line" id="fe" name="email" type="email" autocomplete="email" style="padding:8px 0">
      <button class="btn-outline stay-submit" type="submit">Send</button>
    </form>
  </div>
</section>
